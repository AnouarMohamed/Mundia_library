{
  "name": "university-library",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "deps:build-native": "npm rebuild esbuild sharp unrs-resolver --ignore-scripts=false",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=low",
    "security:audit:runtime": "npm audit --omit=dev --audit-level=low",
    "ci:quality": "npm run security:audit && npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "benchmark:api": "node scripts/benchmark-api-routes.mjs",
    "explain:hot-queries": "tsx scripts/explain-hot-queries.ts",
    "loadtest:nightly": "node scripts/nightly-load-test.mjs",
    "seed": "tsx database/seed.ts",
    "db:migrate-csv": "tsx database/migrate-from-csv.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify-schema": "node scripts/verify-production-schema.mjs",
    "db:verify-concurrency": "node scripts/verify-concurrency-invariants.mjs",
    "db:push": "drizzle-kit push",
    "db:perf-indexes": "tsx scripts/add-performance-indexes.ts",
    "db:studio": "drizzle-kit studio",
    "auth:identity": "tsx scripts/manage-federated-identity.ts",
    "auth:capability": "tsx scripts/manage-admin-capability.ts",
    "verify-stats": "tsx scripts/verify-stats.ts",
    "verify-borrow": "tsx scripts/verify-borrow-details.ts",
    "fix-borrow-sync": "tsx scripts/fix-borrow-sync.ts",
    "fix-overcorrection": "tsx scripts/fix-overcorrection.ts",
    "find-missing-borrow": "tsx scripts/find-missing-borrow.ts",
    "check-all-books": "tsx scripts/check-all-books.ts",
    "fix-coding-interview": "tsx scripts/fix-coding-interview.ts"
  },
