    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.3",
    "@upstash/workflow": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "html5-qrcode": "^2.3.8",
