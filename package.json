    "react-dom": "^19.2.3",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.2.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.7.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
