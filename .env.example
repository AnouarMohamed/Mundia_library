# Local development example.
# Copy this file to .env.local and replace placeholders for services you use.
# Do not commit .env.local, .env, service tokens, database passwords, or production secrets.
# Required explicitly in every production build/runtime; use production there.
APP_ENV=development

# App URLs
NEXT_PUBLIC_API_ENDPOINT=http://localhost:3000
NEXT_PUBLIC_PROD_API_ENDPOINT=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Set true only when a trusted ingress strips and rewrites forwarding headers.
TRUST_PROXY_HEADERS=false

# Auth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-local-secret
# Auth.js also accepts AUTH_SECRET. Keep it aligned with NEXTAUTH_SECRET when set.
AUTH_SECRET=replace-with-local-secret
# Local password compatibility is enabled by default only in development/test.
# Set false to exercise the OIDC-only UI locally. It is forbidden in staging/production.
ENABLE_LOCAL_CREDENTIALS=true

# Institutional OIDC (mandatory in staging/production).
# The issuer must match the provider's `iss` claim byte-for-byte and use HTTPS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exact comma-separated domains; suffix matches are not accepted.
OIDC_ALLOWED_EMAIL_DOMAINS=

# PostgreSQL
DATABASE_URL=postgresql://postgres:rootpassword@localhost:5432/library_management
# Per-process pool budget. Production should use a pooled endpoint or PgBouncer.
DATABASE_POOL_MAX=10
# Legacy/BFF safety budgets; the target services own separate pool budgets.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=library_management
POSTGRES_PORT=5432

# Docker Compose ports
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
ADMINER_PORT=8080

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Upstash Redis and QStash
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Mundiapolis Library
RESEND_TOKEN=

# Background workflows
ENABLE_WORKFLOWS=false
# Legacy credential signup and known fixture accounts are local-only.
ALLOW_PUBLIC_SIGNUP=true
ALLOW_TEST_FIXTURES=true

# Local and CI controls
DISABLE_RATE_LIMIT=true

# Optional Playwright authenticated security checks.
# Leave blank to skip credential-dependent E2E cases.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PENDING_EMAIL=
E2E_PENDING_PASSWORD=
E2E_OTHER_USER_ID=

# Optional API benchmark tuning
BENCH_BASE_URL=http://127.0.0.1:3000
BENCH_WARMUP=5
BENCH_ITERATIONS=20
BENCH_ROUNDS=3
BENCH_BOOKS_LIST_P95_MS=500
BENCH_BOOKS_GENRES_P95_MS=350
BENCH_BOOKS_RECOMMENDATIONS_P95_MS=550
BENCH_BOOK_DETAILS_P95_MS=450

# Optional nightly load-test tuning
LOADTEST_BASE_URL=http://127.0.0.1:3000
LOADTEST_TOTAL_REQUESTS=240
LOADTEST_CONCURRENCY=20
LOADTEST_BOOKS_P95_MS=700
LOADTEST_GENRES_P95_MS=500
LOADTEST_RECOMMENDATIONS_P95_MS=800
LOADTEST_BOOK_ID_P95_MS=650
LOADTEST_MAX_REGRESSION_PERCENT=25
