{
  "openapi": "3.1.0",
  "info": {
    "title": "Mundiapolis Circulation API",
    "version": "1.0.0",
    "description": "Authoritative version 1 command and operational-read contract for the circulation bounded context. All commands require an actor-scoped Idempotency-Key.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [
    { "url": "/", "description": "The same origin as the published contract" }
  ],
  "tags": [
    { "name": "Loans", "description": "Idempotent loan lifecycle commands" },
    { "name": "Inventory", "description": "Audited physical-copy inventory commands" },
    { "name": "Fines", "description": "Idempotent fine and immutable-ledger commands" },
    { "name": "Reservations", "description": "Fair, copy-backed reservation queue commands" },
    { "name": "Membership", "description": "Privacy-preserving membership projections" },
    { "name": "Policy", "description": "Versioned effective circulation policy" },
    { "name": "Operations", "description": "Authenticated operational read models" }
  ],
  "paths": {
    "/api/v1/circulation/status": {
      "get": {
        "operationId": "getCirculationStatus",
        "tags": ["Operations"],
        "summary": "Read the service status projection",
        "x-required-scopes": ["circulation.read"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current status",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CirculationStatus" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/circulation/policy": {
      "get": {
        "operationId": "getCirculationPolicy",
        "tags": ["Policy"],
        "summary": "Read the effective circulation policy and revision",
        "x-required-scopes": ["circulation.policy.read"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Effective policy",
            "headers": { "ETag": { "$ref": "#/components/headers/PolicyRevision" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CirculationPolicyResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "put": {
        "operationId": "updateCirculationPolicy",
        "tags": ["Policy"],
        "summary": "Install a new immutable circulation policy revision",
        "x-required-scopes": ["circulation.policy.manage"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCirculationPolicyRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/PolicyUpdated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/members/{memberId}/eligibility": {
      "get": {
        "operationId": "getMemberEligibility",
        "tags": ["Membership"],
        "summary": "Read a member eligibility projection",
        "description": "Self-service callers may read only the membership_id bound to their token. The read-any scope is required for staff access.",
        "x-required-scopes": ["circulation.eligibility.read", "circulation.eligibility.read.any"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MemberId" }],
        "responses": {
          "200": {
            "description": "Current projected membership eligibility",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemberEligibilityResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/circulation/loans": {
      "post": {
        "operationId": "requestLoan",
        "tags": ["Loans"],
        "summary": "Request a loan",
        "x-required-scopes": ["circulation.loan.request", "circulation.loan.request.on-behalf"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestLoanRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/LoanCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/approve": {
      "post": {
        "operationId": "approveLoan",
        "tags": ["Loans"],
        "summary": "Approve a requested loan and allocate one copy",
        "x-required-scopes": ["circulation.loan.approve"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/reject": {
      "post": {
        "operationId": "rejectLoan",
        "tags": ["Loans"],
        "summary": "Reject a requested loan",
        "x-required-scopes": ["circulation.loan.reject"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/cancel": {
      "post": {
        "operationId": "cancelLoan",
        "tags": ["Loans"],
        "summary": "Cancel a requested loan",
        "x-required-scopes": ["circulation.loan.cancel", "circulation.loan.cancel.on-behalf"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/return": {
      "post": {
        "operationId": "returnLoan",
        "tags": ["Loans"],
        "summary": "Return an active loan and release its copy",
        "x-required-scopes": ["circulation.loan.return"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/renew": {
      "post": {
        "operationId": "renewLoan",
        "tags": ["Loans"],
        "summary": "Renew an eligible active loan",
        "x-required-scopes": ["circulation.loan.renew", "circulation.loan.renew.on-behalf"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/v1/circulation/reservations": {
      "post": {
        "operationId": "placeReservation",
        "tags": ["Reservations"],
        "summary": "Join the fair reservation queue for an edition",
        "x-required-scopes": ["circulation.reservation.place", "circulation.reservation.place.on-behalf"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceReservationRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/ReservationCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/v1/circulation/reservations/{reservationId}/cancel": {
      "post": {
        "operationId": "cancelReservation",
        "tags": ["Reservations"],
        "summary": "Cancel an open reservation and promote the next member",
        "x-required-scopes": ["circulation.reservation.cancel", "circulation.reservation.cancel.on-behalf"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ReservationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ReservationCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/reservations/{reservationId}/fulfill": {
      "post": {
        "operationId": "fulfillReservation",
        "tags": ["Reservations"],
        "summary": "Fulfil a ready hold and atomically create its active loan",
        "x-required-scopes": ["circulation.reservation.fulfill"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ReservationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ReservationCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/v1/circulation/reservations/{reservationId}/expire": {
      "post": {
        "operationId": "expireReservation",
        "tags": ["Reservations"],
        "summary": "Expire a due hold and promote the next member",
        "x-required-scopes": ["circulation.reservation.expire"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ReservationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ReservationCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/copies": {
      "post": {
        "operationId": "registerCopy",
        "tags": ["Inventory"],
        "summary": "Register a physical copy in available inventory",
        "x-required-scopes": ["circulation.inventory.register"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterCopyRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/InventoryCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/copies/{copyId}/condition": {
      "post": {
        "operationId": "changeCopyCondition",
        "tags": ["Inventory"],
        "summary": "Record an allowed physical-copy condition transition",
        "x-required-scopes": ["circulation.inventory.condition.update"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CopyId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeCopyConditionRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/InventoryCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/copies/{copyId}/relocations": {
      "post": {
        "operationId": "relocateCopy",
        "tags": ["Inventory"],
        "summary": "Move an available copy to a branch shelf",
        "x-required-scopes": ["circulation.inventory.relocate"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CopyId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RelocateCopyRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/InventoryCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/fines": {
      "post": {
        "operationId": "assessFine",
        "tags": ["Fines"],
        "summary": "Assess a fine against an eligible loan",
        "x-required-scopes": ["circulation.fine.assess"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssessFineRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/FineCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/fines/{fineId}/payments": {
      "post": {
        "operationId": "recordFinePayment",
        "tags": ["Fines"],
        "summary": "Record an externally settled fine payment",
        "x-required-scopes": ["circulation.fine.payment.record"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/FineId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordFinePaymentRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/FineCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/circulation/fines/{fineId}/adjustments": {
      "post": {
        "operationId": "adjustFine",
        "tags": ["Fines"],
        "summary": "Apply an auditable fine adjustment",
        "x-required-scopes": ["circulation.fine.adjust"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/FineId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdjustFineRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/FineCommandSucceeded" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC access token. Exact required scopes are listed by x-required-scopes on each operation."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Actor-scoped command key. Reuse with a different payload is rejected.",
        "schema": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[!-~]+$" }
      },
      "LoanId": {
        "name": "loanId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "CopyId": {
        "name": "copyId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "FineId": {
        "name": "fineId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "MemberId": {
        "name": "memberId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ReservationId": {
        "name": "reservationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "The exact effective policy revision returned by the latest read.",
        "schema": { "type": "string", "pattern": "^\"?[0-9a-fA-F-]{36}\"?$" }
      }
    },
    "headers": {
      "IdempotencyReplayed": {
        "description": "True when the stored result for this actor and key was replayed.",
        "required": true,
        "schema": { "type": "boolean" }
      },
      "Location": {
        "description": "Canonical path of the created resource.",
        "required": true,
        "schema": { "type": "string", "format": "uri-reference" }
      },
      "PolicyRevision": {
        "description": "Quoted immutable policy revision for the next If-Match update.",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "LoanCreated": {
        "description": "Loan request created or its original result replayed",
        "headers": {
          "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" },
          "Location": { "$ref": "#/components/headers/Location" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoanCommandResponse" } } }
      },
      "LoanCommandSucceeded": {
        "description": "Loan command committed or its original result replayed",
        "headers": { "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoanCommandResponse" } } }
      },
      "FineCreated": {
        "description": "Fine created or its original result replayed",
        "headers": {
          "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" },
          "Location": { "$ref": "#/components/headers/Location" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FineCommandResponse" } } }
      },
      "FineCommandSucceeded": {
        "description": "Fine command committed or its original result replayed",
        "headers": { "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FineCommandResponse" } } }
      },
      "InventoryCreated": {
        "description": "Copy registered or its original result replayed",
        "headers": {
          "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" },
          "Location": { "$ref": "#/components/headers/Location" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryCommandResponse" } } }
      },
      "InventoryCommandSucceeded": {
        "description": "Inventory command committed or its original result replayed",
        "headers": { "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryCommandResponse" } } }
      },
      "ReservationCreated": {
        "description": "Reservation placed or its exact original result replayed",
        "headers": { "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationCommandResponse" } } }
      },
      "ReservationCommandSucceeded": {
        "description": "Reservation command committed or its exact original result replayed",
        "headers": { "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationCommandResponse" } } }
      },
      "PolicyUpdated": {
        "description": "New immutable policy revision installed or its original result replayed",
        "headers": {
          "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" },
          "ETag": { "$ref": "#/components/headers/PolicyRevision" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CirculationPolicyResponse" } } }
      },
      "BadRequest": {
        "description": "Malformed request or invalid command input",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Forbidden": {
        "description": "Token lacks a required scope or may not act for the member",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "NotFound": {
        "description": "Requested resource does not exist or is hidden from this caller",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Conflict": {
        "description": "Lifecycle, invariant, concurrency, or idempotency conflict",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "UnprocessableEntity": {
        "description": "The projected membership state makes this loan decision ineligible",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "ServiceUnavailable": {
        "description": "A required admission or membership dependency is unavailable and the request fails closed",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "TooManyRequests": {
        "description": "The authenticated principal exhausted the applicable distributed request budget",
        "headers": {
          "Retry-After": { "schema": { "type": "integer", "minimum": 1 } },
          "RateLimit-Limit": { "schema": { "type": "integer", "minimum": 1 } },
          "RateLimit-Remaining": { "schema": { "type": "integer", "minimum": 0 } },
          "RateLimit-Reset": {
            "description": "Whole seconds until the current rate-limit window resets",
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "CirculationStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "activeLoans"],
        "properties": {
          "service": { "type": "string", "const": "circulation-service" },
          "activeLoans": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "CirculationPolicyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "sequence", "defaultLoanPeriod", "renewalPeriod", "maximumRenewals", "fineCurrency", "reservationHoldPeriod", "maximumActiveReservations", "effectiveAt"],
        "properties": {
          "revision": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "format": "int64", "minimum": 0 },
          "defaultLoanPeriod": { "type": "string", "format": "duration", "example": "PT336H" },
          "renewalPeriod": { "type": "string", "format": "duration", "example": "PT336H" },
          "maximumRenewals": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100 },
          "fineCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "reservationHoldPeriod": { "type": "string", "format": "duration", "example": "PT48H" },
          "maximumActiveReservations": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100 },
          "effectiveAt": { "type": "string", "format": "date-time" }
        }
      },
      "UpdateCirculationPolicyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defaultLoanPeriod", "renewalPeriod", "maximumRenewals", "fineCurrency", "reservationHoldPeriod", "maximumActiveReservations"],
        "properties": {
          "defaultLoanPeriod": { "type": "string", "format": "duration", "example": "P14D" },
          "renewalPeriod": { "type": "string", "format": "duration", "example": "P14D" },
          "maximumRenewals": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100 },
          "fineCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "reservationHoldPeriod": { "type": "string", "format": "duration", "example": "PT48H" },
          "maximumActiveReservations": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100 }
        }
      },
      "MemberEligibilityResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "status", "reasonCode", "sourceVersion", "sourceOccurredAt"],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["ELIGIBLE", "INELIGIBLE", "SUSPENDED"] },
          "reasonCode": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "sourceVersion": { "type": "integer", "format": "int64", "minimum": 0 },
          "sourceOccurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "RequestLoanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "editionId"],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "editionId": { "type": "string", "format": "uuid" }
        }
      },
      "PlaceReservationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "editionId"],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "editionId": { "type": "string", "format": "uuid" }
        }
      },
      "ReservationCommandResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reservationId", "memberId", "editionId", "copyId", "status", "placedAt", "readyAt", "expiresAt", "fulfilledAt", "cancelledAt", "version"],
        "properties": {
          "reservationId": { "type": "string", "format": "uuid" },
          "memberId": { "type": "string", "format": "uuid" },
          "editionId": { "type": "string", "format": "uuid" },
          "copyId": { "type": ["string", "null"], "format": "uuid" },
          "status": { "type": "string", "enum": ["WAITING", "READY", "FULFILLED", "CANCELLED", "EXPIRED"] },
          "placedAt": { "type": "string", "format": "date-time" },
          "readyAt": { "type": ["string", "null"], "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "fulfilledAt": { "type": ["string", "null"], "format": "date-time" },
          "cancelledAt": { "type": ["string", "null"], "format": "date-time" },
          "version": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "RegisterCopyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["copyId", "editionId", "branchId", "barcode", "shelfLocation", "reason"],
        "properties": {
          "copyId": { "type": "string", "format": "uuid" },
          "editionId": { "type": "string", "format": "uuid" },
          "branchId": { "type": "string", "format": "uuid" },
          "barcode": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,63}$" },
          "shelfLocation": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "reason": { "$ref": "#/components/schemas/InventoryReason" }
        }
      },
      "ChangeCopyConditionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "reason"],
        "properties": {
          "status": { "type": "string", "enum": ["AVAILABLE", "LOST", "DAMAGED", "WITHDRAWN"] },
          "reason": { "$ref": "#/components/schemas/InventoryReason" }
        }
      },
      "RelocateCopyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branchId", "shelfLocation", "reason"],
        "properties": {
          "branchId": { "type": "string", "format": "uuid" },
          "shelfLocation": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reason": { "$ref": "#/components/schemas/InventoryReason" }
        }
      },
      "InventoryReason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
      },
      "InventoryCommandResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["copyId", "editionId", "branchId", "barcode", "status", "shelfLocation", "version", "occurredAt"],
        "properties": {
          "copyId": { "type": "string", "format": "uuid" },
          "editionId": { "type": "string", "format": "uuid" },
          "branchId": { "type": "string", "format": "uuid" },
          "barcode": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,63}$" },
          "status": { "type": "string", "enum": ["AVAILABLE", "ON_LOAN", "RESERVED", "LOST", "DAMAGED", "WITHDRAWN"] },
          "shelfLocation": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "version": { "type": "integer", "format": "int64", "minimum": 0 },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "AssessFineRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["loanId", "amountMinor", "reason"],
        "properties": {
          "loanId": { "type": "string", "format": "uuid" },
          "amountMinor": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 1000000000000 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$" }
        }
      },
      "RecordFinePaymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "amountMinor", "externalReference"],
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "amountMinor": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 1000000000000 },
          "externalReference": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[!-~]+$" }
        }
      },
      "AdjustFineRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "deltaMinor", "reason"],
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "deltaMinor": { "type": "integer", "format": "int64", "minimum": -1000000000000, "maximum": 1000000000000, "not": { "const": 0 } },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$" }
        }
      },
      "LoanCommandResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["loanId", "memberId", "editionId", "copyId", "status", "requestedAt", "checkedOutAt", "dueAt", "returnedAt", "renewalCount", "version"],
        "properties": {
          "loanId": { "type": "string", "format": "uuid" },
          "memberId": { "type": "string", "format": "uuid" },
          "editionId": { "type": "string", "format": "uuid" },
          "copyId": { "type": ["string", "null"], "format": "uuid" },
          "status": { "type": "string", "enum": ["REQUESTED", "ACTIVE", "RETURNED", "REJECTED", "CANCELLED"] },
          "requestedAt": { "type": "string", "format": "date-time" },
          "checkedOutAt": { "type": ["string", "null"], "format": "date-time" },
          "dueAt": { "type": ["string", "null"], "format": "date-time" },
          "returnedAt": { "type": ["string", "null"], "format": "date-time" },
          "renewalCount": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 100 },
          "version": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "FineCommandResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fineId", "loanId", "memberId", "currency", "balanceMinor", "status", "version", "ledgerEntryId", "ledgerEntryType", "ledgerDeltaMinor", "occurredAt"],
        "properties": {
          "fineId": { "type": "string", "format": "uuid" },
          "loanId": { "type": "string", "format": "uuid" },
          "memberId": { "type": "string", "format": "uuid" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "balanceMinor": { "type": "integer", "format": "int64", "minimum": 0, "maximum": 1000000000000 },
          "status": { "type": "string", "enum": ["OPEN", "SETTLED"] },
          "version": { "type": "integer", "format": "int64", "minimum": 0 },
          "ledgerEntryId": { "type": "string", "format": "uuid" },
          "ledgerEntryType": { "type": "string", "enum": ["ASSESSMENT", "PAYMENT", "ADJUSTMENT"] },
          "ledgerDeltaMinor": { "type": "integer", "format": "int64", "minimum": -1000000000000, "maximum": 1000000000000 },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" },
          "code": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    }
  }
}
