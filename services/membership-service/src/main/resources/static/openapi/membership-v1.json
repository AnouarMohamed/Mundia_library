{
  "openapi": "3.1.0",
  "info": {
    "title": "Mundiapolis Membership API",
    "version": "1.3.0",
    "description": "Authoritative version 1 contract for member profiles, borrowing eligibility, immutable privacy-minimal eligibility snapshots, privacy-safe identity-evidence metadata and verified transfer receipts, versioned account-status commands, and reconciled legacy imports.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [
    { "url": "/", "description": "The same origin as the published contract" }
  ],
  "paths": {
    "/api/v1/members": {
      "get": {
        "operationId": "listMembersForAdministration",
        "summary": "List members for administrative review",
        "description": "Returns a bounded, status-filtered keyset page. Aggregate versions are included for safe status commands.",
        "x-required-scopes": ["membership.members.read"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/AccountStatus", "default": "PENDING" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Administrative member page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AdminMemberPage" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/members/me/profile": {
      "get": {
        "operationId": "getOwnMemberProfile",
        "summary": "Read the profile bound to the caller's membership identity",
        "description": "Resolves the member exclusively from the canonical membership_id claim. No caller-controlled member identifier is accepted.",
        "x-required-scopes": ["membership.profile.read"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Caller-bound member profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemberProfile" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/members/{memberId}/profile": {
      "get": {
        "operationId": "getMemberProfile",
        "summary": "Read an authoritative member profile",
        "description": "Self-service callers must request the membership_id bound to their token. The read-any scope permits delegated access.",
        "x-required-scopes": [
          "membership.profile.read",
          "membership.profile.read.any"
        ],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MemberId" }],
        "responses": {
          "200": {
            "description": "Member profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemberProfile" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/members/{memberId}/eligibility": {
      "get": {
        "operationId": "getMemberEligibility",
        "summary": "Evaluate borrowing eligibility from authoritative membership state",
        "description": "Unknown members and incomplete state fail closed. Self-service callers must request the membership_id bound to their token.",
        "x-required-scopes": [
          "membership.eligibility.read",
          "membership.eligibility.read.any"
        ],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MemberId" }],
        "responses": {
          "200": {
            "description": "Current eligibility decision",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemberEligibility" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/members/{memberId}/identity-evidence": {
      "get": {
        "operationId": "getMemberIdentityEvidence",
        "summary": "Read privacy-safe identity-evidence metadata",
        "description": "Returns integrity metadata only. Private object keys and durable or signed URLs are never exposed by this operation.",
        "x-required-scopes": ["membership.identity-evidence.read"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MemberId" }],
        "responses": {
          "200": {
            "description": "Identity-evidence metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentityEvidenceRef" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/members/{memberId}/status": {
      "post": {
        "operationId": "changeMemberAccountStatus",
        "summary": "Change authoritative member account status",
        "description": "Requires an actor-bound idempotency key, a canonical membership_id claim, and an exact aggregate-version ETag. Operators cannot change their own status, and the final approved administrator is protected. The state change, audit entry, and eligibility outbox event commit atomically.",
        "x-required-scopes": ["membership.status.manage"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/MemberId" },
          { "$ref": "#/components/parameters/IfMatch" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeAccountStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account status changed or exact prior result replayed",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                  "pattern": "^\\\"(0|[1-9][0-9]*)\\\"$"
                }
              },
              "Idempotency-Replayed": {
                "schema": { "type": "string", "enum": ["true", "false"] }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipCommandResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/members/identity-evidence-transfers/{transferId}": {
      "get": {
        "operationId": "getIdentityEvidenceTransfer",
        "summary": "Read an immutable identity-evidence transfer receipt",
        "description": "Returns reconciliation metadata only. The private object key, source locator, and scanner attestation are never returned.",
        "x-required-scopes": ["membership.identity-evidence.transfer"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TransferId" }],
        "responses": {
          "200": {
            "description": "Identity-evidence transfer receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentityEvidenceTransferResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "transferIdentityEvidence",
        "summary": "Register one independently verified legacy evidence transfer",
        "description": "Atomically binds a quarantined legacy-reference digest to an opaque private-storage object after external normalization and malware scanning. Exact replays require the same actor and manifest.",
        "x-required-scopes": ["membership.identity-evidence.transfer"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TransferId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IdentityEvidenceTransferRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transfer registered or exact prior receipt replayed",
            "headers": {
              "Idempotency-Replayed": {
                "schema": { "type": "string", "enum": ["true", "false"] }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentityEvidenceTransferResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "description": "The transfer body exceeds the bounded command envelope" }
        }
      }
    },
    "/api/v1/members/eligibility-snapshots/{snapshotId}": {
      "get": {
        "operationId": "getEligibilitySnapshotReceipt",
        "summary": "Read an immutable eligibility snapshot receipt",
        "description": "Returns reconciliation metadata only and is visible exclusively to the actor that created the snapshot.",
        "x-required-scopes": ["membership.eligibility.snapshot"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SnapshotId" }],
        "responses": {
          "200": {
            "description": "Eligibility snapshot receipt",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EligibilitySnapshotReceipt" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "createEligibilitySnapshot",
        "summary": "Create an immutable eligibility projection snapshot",
        "description": "Captures a consistent, privacy-minimal projection of authoritative membership eligibility. The same identifier is replayable only by the same actor.",
        "x-required-scopes": ["membership.eligibility.snapshot"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SnapshotId" }],
        "responses": {
          "200": {
            "description": "Snapshot created or exact prior receipt replayed",
            "headers": {
              "Idempotency-Replayed": { "schema": { "type": "string", "enum": ["true", "false"] } }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EligibilitySnapshotReceipt" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/members/eligibility-snapshots/{snapshotId}/items": {
      "get": {
        "operationId": "listEligibilitySnapshotItems",
        "summary": "Read a keyset page from an immutable eligibility snapshot",
        "description": "Returns member identifiers and projection facts only; names, email addresses, evidence, and loan counts are excluded.",
        "x-required-scopes": ["membership.eligibility.snapshot"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SnapshotId" },
          { "name": "afterMemberId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Eligibility snapshot page",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EligibilitySnapshotPage" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/members/legacy-imports/{importId}": {
      "get": {
        "operationId": "getLegacyMembershipImport",
        "summary": "Read an immutable legacy membership import receipt",
        "description": "Returns the durable reconciliation receipt for an exact import identifier. Member data and quarantined evidence references are not returned.",
        "x-required-scopes": ["membership.import"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ImportId" }],
        "responses": {
          "200": {
            "description": "Legacy membership import receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegacyMembershipImportResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "importLegacyMembershipBatch",
        "summary": "Import one deterministic legacy membership batch",
        "description": "Creates or exactly reconciles a bounded member batch and quarantines each unverified legacy evidence reference as a SHA-256 digest. The same import identifier is replayable only by the same actor with the same manifest.",
        "x-required-scopes": ["membership.import"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ImportId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LegacyMembershipImportRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch imported or exact prior receipt replayed",
            "headers": {
              "Idempotency-Replayed": {
                "schema": { "type": "string", "enum": ["true", "false"] }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegacyMembershipImportResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "description": "The import body exceeds the bounded migration envelope" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "MemberId": {
        "name": "memberId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ImportId": {
        "name": "importId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "TransferId": {
        "name": "transferId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "SnapshotId": {
        "name": "snapshotId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "pattern": "^\\\"(0|[1-9][0-9]*)\\\"$" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
      }
    },
    "schemas": {
      "EligibilitySnapshotItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "status", "reasonCode", "sourceVersion", "sourceOccurredAt", "contentSha256"],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["ELIGIBLE", "INELIGIBLE", "SUSPENDED"] },
          "reasonCode": { "type": ["string", "null"], "enum": ["ACCOUNT_NOT_APPROVED", "ACTIVE_LOAN_LIMIT_REACHED", "UNPAID_OVERDUE_FINES", null] },
          "sourceVersion": { "type": "integer", "minimum": 0 },
          "sourceOccurredAt": { "type": "string", "format": "date-time" },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "EligibilitySnapshotReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshotId", "sourceRevision", "manifestSha256", "memberCount", "createdAt", "replayed"],
        "properties": {
          "snapshotId": { "type": "string", "format": "uuid" },
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "memberCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "createdAt": { "type": "string", "format": "date-time" },
          "replayed": { "type": "boolean" }
        }
      },
      "EligibilitySnapshotPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshotId", "items", "nextAfterMemberId"],
        "properties": {
          "snapshotId": { "type": "string", "format": "uuid" },
          "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/EligibilitySnapshotItem" } },
          "nextAfterMemberId": { "type": ["string", "null"], "format": "uuid" }
        }
      },
      "AdminMemberPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/AdminMemberSummary" }
          },
          "nextCursor": { "type": ["string", "null"], "minLength": 16, "maxLength": 200 }
        }
      },
      "AdminMemberSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "email", "fullName", "universityId", "status", "role", "aggregateVersion", "createdAt", "updatedAt"],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "fullName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "universityId": { "type": "integer", "minimum": 1 },
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "role": { "$ref": "#/components/schemas/MembershipRole" },
          "aggregateVersion": { "type": "integer", "minimum": 0 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MemberProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "email",
          "fullName",
          "universityId",
          "status",
          "role",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "fullName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "universityId": { "type": "integer", "minimum": 1 },
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "role": { "$ref": "#/components/schemas/MembershipRole" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MemberEligibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "eligible",
          "status",
          "maxActiveLoans",
          "currentActiveLoans",
          "hasUnpaidOverdueFines",
          "evaluatedAt"
        ],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "eligible": { "type": "boolean" },
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "maxActiveLoans": { "type": "integer", "minimum": 0 },
          "currentActiveLoans": { "type": "integer", "minimum": 0 },
          "hasUnpaidOverdueFines": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
          "evaluatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "IdentityEvidenceRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "memberId",
          "mimeType",
          "fileSize",
          "checksumSha256",
          "uploadedAt",
          "verificationStatus",
          "verifiedAt",
          "retentionExpiresAt"
        ],
        "properties": {
          "evidenceId": { "type": "string", "format": "uuid" },
          "memberId": { "type": "string", "format": "uuid" },
          "mimeType": {
            "type": "string",
            "enum": ["application/pdf", "image/jpeg", "image/png"]
          },
          "fileSize": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "uploadedAt": { "type": "string", "format": "date-time" },
          "verificationStatus": { "$ref": "#/components/schemas/IdentityEvidenceVerificationStatus" },
          "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
          "retentionExpiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "IdentityEvidenceTransferRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "evidenceId",
          "objectKey",
          "mimeType",
          "fileSize",
          "checksumSha256",
          "sourceReferenceSha256",
          "scanAttestationSha256",
          "verifiedAt",
          "retentionExpiresAt"
        ],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "evidenceId": { "type": "string", "format": "uuid" },
          "objectKey": { "type": "string", "pattern": "^identity-evidence/[a-f0-9-]{36}/[a-f0-9-]{36}$" },
          "mimeType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"] },
          "fileSize": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceReferenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "scanAttestationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "retentionExpiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "IdentityEvidenceTransferResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transferId", "evidenceId", "manifestSha256", "completedAt", "replayed"],
        "properties": {
          "transferId": { "type": "string", "format": "uuid" },
          "evidenceId": { "type": "string", "format": "uuid" },
          "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "completedAt": { "type": "string", "format": "date-time" },
          "replayed": { "type": "boolean" }
        }
      },
      "ChangeAccountStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "reason"],
        "properties": {
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "reason": { "type": "string", "minLength": 8, "maxLength": 500 }
        }
      },
      "MembershipCommandResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "aggregateVersion",
          "status",
          "occurredAt",
          "replayed"
        ],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "aggregateVersion": { "type": "integer", "minimum": 1 },
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "replayed": { "type": "boolean" }
        }
      },
      "LegacyMembershipImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRevision", "items"],
        "properties": {
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/LegacyMembershipImportItemRequest" }
          }
        }
      },
      "LegacyMembershipImportItemRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "email",
          "fullName",
          "universityId",
          "status",
          "role",
          "maxActiveLoans",
          "currentActiveLoans",
          "hasUnpaidOverdueFines",
          "createdAt",
          "updatedAt",
          "evidenceReferenceSha256",
          "contentSha256"
        ],
        "properties": {
          "memberId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "fullName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "universityId": { "type": "integer", "minimum": 1 },
          "status": { "$ref": "#/components/schemas/AccountStatus" },
          "role": { "$ref": "#/components/schemas/MembershipRole" },
          "maxActiveLoans": { "type": "integer", "minimum": 0, "maximum": 100 },
          "currentActiveLoans": { "type": "integer", "minimum": 0, "maximum": 100 },
          "hasUnpaidOverdueFines": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "evidenceReferenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "LegacyMembershipImportResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "importId",
          "sourceRevision",
          "manifestSha256",
          "memberCount",
          "quarantinedEvidenceCount",
          "completedAt",
          "replayed"
        ],
        "properties": {
          "importId": { "type": "string", "format": "uuid" },
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "memberCount": { "type": "integer", "minimum": 1, "maximum": 100 },
          "quarantinedEvidenceCount": { "type": "integer", "minimum": 1, "maximum": 100 },
          "completedAt": { "type": "string", "format": "date-time" },
          "replayed": { "type": "boolean" }
        }
      },
      "AccountStatus": {
        "type": "string",
        "enum": ["PENDING", "APPROVED", "REJECTED"]
      },
      "IdentityEvidenceVerificationStatus": {
        "type": "string",
        "enum": ["LEGACY_UNATTESTED", "VERIFIED"]
      },
      "MembershipRole": { "type": "string", "enum": ["USER", "ADMIN", "SUPER_ADMIN"] }
    },
    "responses": {
      "BadRequest": {
        "description": "The command headers or body are invalid"
      },
      "Unauthorized": { "description": "A valid bearer token is required" },
      "Forbidden": {
        "description": "The token lacks the required scope or member binding"
      },
      "NotFound": {
        "description": "The requested membership resource does not exist"
      },
      "Conflict": {
        "description": "The aggregate version or idempotency claim conflicts"
      }
    }
  }
}
