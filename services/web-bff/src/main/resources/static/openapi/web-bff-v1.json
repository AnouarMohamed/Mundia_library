{
  "openapi": "3.1.0",
  "info": {
    "title": "Mundiapolis Library Web BFF API",
    "version": "1.1.0",
    "description": "Browser contract for the static React application. Domain-service contracts are not exposed directly."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Get the safe browser-session projection",
        "responses": {
          "200": {
            "description": "Current authentication state",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Session" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "summary": "Bootstrap a CSRF token for state-changing requests",
        "responses": {
          "200": {
            "description": "CSRF token and submission fields",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CsrfToken" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Invalidate the current browser session",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": {
          "204": { "description": "Session invalidated" },
          "403": { "description": "CSRF token missing or invalid" }
        }
      }
    },
    "/api/v1/catalog/search": {
      "get": {
        "operationId": "searchCatalog",
        "summary": "Search the catalog through the BFF",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "query", "in": "query", "schema": { "type": "string", "maxLength": 200 } },
          { "name": "genre", "in": "query", "schema": { "type": "string", "maxLength": 120 } },
          { "name": "authorId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "availableOnly", "in": "query", "schema": { "type": "boolean" } },
          { "name": "minRating", "in": "query", "schema": { "type": "number", "minimum": 0, "maximum": 5 } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["title", "rating", "publicationYear"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Bounded catalog search results",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CatalogSearch" } }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Authenticated browser session required" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/membership/profile": {
      "get": {
        "operationId": "getOwnMembershipProfile",
        "summary": "Get the authenticated member's profile through delegated authorization",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Authoritative membership profile bound to the authenticated session",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MemberProfile" } }
            }
          },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/circulation/eligibility": {
      "get": {
        "operationId": "getOwnCirculationEligibility",
        "summary": "Get the authenticated member's circulation eligibility",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Caller-bound circulation eligibility projection",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CirculationEligibility" } }
            }
          },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/circulation/loans": {
      "get": {
        "operationId": "getOwnLoans",
        "summary": "List the authenticated member's loan history",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["REQUESTED", "ACTIVE", "RETURNED", "REJECTED", "CANCELLED"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9_-]+$" } }
        ],
        "responses": {
          "200": {
            "description": "Caller-bound keyset page",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemberLoanPage" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      },
      "post": {
        "operationId": "requestOwnLoan",
        "summary": "Request a loan for the authenticated member",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RequestLoan" } }
          }
        },
        "responses": {
          "201": {
            "description": "Loan request committed or its original result replayed",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } },
              "Idempotency-Replayed": { "schema": { "type": "string", "enum": ["true", "false"] } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LoanCommand" } }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/cancel": {
      "post": {
        "operationId": "cancelOwnLoan",
        "summary": "Cancel the authenticated member's pending loan request",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/circulation/loans/{loanId}/renew": {
      "post": {
        "operationId": "renewOwnLoan",
        "summary": "Renew the authenticated member's eligible active loan",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/LoanId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LoanCommandSucceeded" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/circulation/reservations": {
      "get": {
        "operationId": "getOwnReservations",
        "summary": "List the authenticated member's reservation history",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["WAITING", "READY", "FULFILLED", "CANCELLED", "EXPIRED"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9_-]+$" } }
        ],
        "responses": {
          "200": {
            "description": "Caller-bound keyset page",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemberReservationPage" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      },
      "post": {
        "operationId": "placeOwnReservation",
        "summary": "Place a reservation for the authenticated member",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RequestReservation" } }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/ReservationCommandSucceeded" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/circulation/reservations/{reservationId}/cancel": {
      "post": {
        "operationId": "cancelOwnReservation",
        "summary": "Cancel the authenticated member's open reservation",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ReservationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ReservationCommandSucceeded" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "operationId": "getOwnNotifications",
        "summary": "List the authenticated member's notification inbox",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ALL", "READ", "UNREAD"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" } }
        ],
        "responses": {
          "200": {
            "description": "Caller-bound notification page",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPage" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/notifications/{notificationId}/read": {
      "patch": {
        "operationId": "markOwnNotificationReadThroughBff",
        "summary": "Idempotently mark an owned notification as read",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [{ "name": "notificationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Notification marked read", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationItem" } } } },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/notifications/preferences": {
      "get": {
        "operationId": "getOwnNotificationPreferenceThroughBff",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Caller-bound notification preference",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }, "ETag": { "schema": { "type": "string", "pattern": "^\\\"[0-9]+\\\"$" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreference" } } }
          },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      },
      "put": {
        "operationId": "updateOwnNotificationPreferenceThroughBff",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [{ "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^\\\"[0-9]+\\\"$" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateNotificationPreference" } } } },
        "responses": {
          "200": { "description": "Preference updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreference" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "428": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/digital-content/editions/{editionId}/availability": {
      "get": {
        "operationId": "getDownloadAvailabilityThroughBff",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "editionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "Rights-safe downloadable formats",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EditionDownloadAvailability" } } }
          },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/digital-content/assets/{assetId}/authorizations": {
      "post": {
        "operationId": "authorizeDownloadThroughBff",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "parameters": [{ "name": "assetId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "Short-lived first-party download authorization",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DownloadAuthorization" } } }
          },
          "401": { "description": "Browser session missing or user authorization must be renewed" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "502": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" },
          "504": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "MUNDIA_SESSION" },
      "csrfHeader": { "type": "apiKey", "in": "header", "name": "X-XSRF-TOKEN" }
    },
    "responses": {
      "EditionDownloadAvailability": {
        "type": "object",
        "required": ["editionId", "downloadable", "formats"],
        "properties": {
          "editionId": { "type": "string", "format": "uuid" },
          "downloadable": { "type": "boolean" },
          "formats": { "type": "array", "maxItems": 2, "items": { "$ref": "#/components/schemas/DownloadableFormat" } }
        },
        "additionalProperties": false
      },
      "DownloadableFormat": {
        "type": "object",
        "required": ["assetId", "format", "mediaType", "sizeBytes", "sha256", "licenseExpression", "attribution"],
        "properties": {
          "assetId": { "type": "string", "format": "uuid" },
          "format": { "type": "string", "enum": ["PDF", "EPUB"] },
          "mediaType": { "type": "string", "enum": ["application/pdf", "application/epub+zip"] },
          "sizeBytes": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 1073741824 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "licenseExpression": { "type": "string", "minLength": 2, "maxLength": 128 },
          "attribution": { "type": "string", "minLength": 2, "maxLength": 1000 }
        },
        "additionalProperties": false
      },
      "DownloadAuthorization": {
        "type": "object",
        "required": ["authorizationId", "assetId", "downloadUrl", "expiresAt"],
        "properties": {
          "authorizationId": { "type": "string", "format": "uuid" },
          "assetId": { "type": "string", "format": "uuid" },
          "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Problem": {
        "description": "Stable non-sensitive error response",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "LoanCommandSucceeded": {
        "description": "Loan command committed or its original result replayed",
        "headers": {
          "Cache-Control": { "schema": { "type": "string", "const": "no-store" } },
          "Idempotency-Replayed": { "schema": { "type": "string", "enum": ["true", "false"] } }
        },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/LoanCommand" } }
        }
      },
      "ReservationCommandSucceeded": {
        "description": "Reservation command committed or its original result replayed",
        "headers": {
          "Cache-Control": { "schema": { "type": "string", "const": "no-store" } },
          "Idempotency-Replayed": { "schema": { "type": "string", "enum": ["true", "false"] } }
        },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ReservationCommand" } }
        }
      }
    },
    "parameters": {
      "LoanId": {
        "name": "loanId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ReservationId": {
        "name": "reservationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Actor-scoped command key. Reuse with a different request is rejected.",
        "schema": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[!-~]+$" }
      }
    },
    "schemas": {
      "Session": {
        "type": "object",
        "required": ["authenticated"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "displayName": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "CsrfToken": {
        "type": "object",
        "required": ["headerName", "parameterName", "token"],
        "properties": {
          "headerName": { "type": "string" },
          "parameterName": { "type": "string" },
          "token": { "type": "string" }
        },
        "additionalProperties": false
      },
      "CatalogSearch": {
        "type": "object",
        "required": ["editions", "total", "page", "totalPages"],
        "properties": {
          "editions": {
            "type": "array",
            "maxItems": 100,
