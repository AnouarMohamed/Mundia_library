{
  "openapi": "3.1.0",
  "info": {
    "title": "Mundia Digital Content API",
    "version": "1.3.0",
    "description": "Rights-aware quarantine ingestion and caller-bound authorization for first-party and verified external digital content. Private keys appear only inside tightly constrained upload or download grants."
  },
  "paths": {
    "/api/v1/digital-content/editions/{editionId}/availability": {
      "get": {
        "operationId": "getEditionDownloadAvailability",
        "parameters": [
          {
            "name": "editionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "security": [{ "oauth2": ["digital-content.availability.read"] }],
        "responses": {
          "200": {
            "description": "Fail-closed availability for globally authorized, clean, published assets",
            "headers": {
              "Cache-Control": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EditionDownloadAvailability" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/digital-content/assets/{assetId}/authorizations": {
      "post": {
        "operationId": "authorizeDownload",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "security": [{ "oauth2": ["digital-content.download.authorize"] }],
        "responses": {
          "200": {
            "description": "A newly authorized, short-lived first-party download URL",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DownloadAuthorization" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/DownloadUnavailable" },
          "503": { "$ref": "#/components/responses/SigningUnavailable" }
        }
      }
    },
    "/api/v1/digital-content/ingestions/{ingestionId}": {
      "put": {
        "operationId": "createDigitalContentIngestion",
        "parameters": [
          {
            "name": "ingestionId",
            "in": "path",
            "required": true,
            "description": "Client-generated idempotency identifier bound to the caller and exact manifest",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "security": [{ "oauth2": ["digital-content.ingestion.create"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateIngestionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay with a fresh grant for the same caller and manifest",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestionUploadGrant" } } }
          },
          "201": {
            "description": "Rights-reviewed manifest stored and checksum-bound quarantine grant issued",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestionUploadGrant" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidIngestion" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/IngestionConflict" },
          "410": { "$ref": "#/components/responses/IngestionExpired" },
          "503": { "$ref": "#/components/responses/IngestionUnavailable" }
        }
      }
    },
    "/api/v1/digital-content/external-resources/{resourceId}": {
      "put": {
        "operationId": "registerExternalResourceRights",
        "parameters": [{ "name": "resourceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "security": [{ "oauth2": ["digital-content.external-resource.manage"] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterExternalResourceRequest" } } }
        },
        "responses": {
          "200": { "description": "Exact caller-bound manifest replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalResourceRegistration" } } } },
          "201": { "description": "Immutable external rights manifest registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalResourceRegistration" } } } },
          "400": { "$ref": "#/components/responses/InvalidExternalResource" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/ExternalResourceConflict" }
        }
      }
    },
    "/api/v1/digital-content/external-resources/{resourceId}/availability": {
      "get": {
        "operationId": "getExternalResourceAvailability",
        "parameters": [{ "name": "resourceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "security": [{ "oauth2": ["digital-content.availability.read"] }],
        "responses": {
          "200": { "description": "Fail-closed external rights availability without a download URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalResourceAvailability" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/digital-content/external-resources/{resourceId}/authorizations": {
      "post": {
        "operationId": "authorizeExternalResourceDownload",
        "parameters": [{ "name": "resourceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "security": [{ "oauth2": ["digital-content.download.authorize"] }],
        "responses": {
          "200": { "description": "Audited authorization for the exact verified official file", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalDownloadAuthorization" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/DownloadUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://identity.example.invalid/oauth2/token",
            "scopes": {
              "digital-content.availability.read": "Read safe digital content availability",
              "digital-content.download.authorize": "Authorize a short-lived first-party download",
              "digital-content.ingestion.create": "Create a rights-reviewed quarantine ingestion session",
              "digital-content.external-resource.manage": "Register immutable rights manifests for external resources"
            }
          }
        }
      }
    },
    "schemas": {
      "EditionDownloadAvailability": {
        "type": "object",
        "additionalProperties": false,
        "required": ["editionId", "downloadable", "formats"],
        "properties": {
          "editionId": { "type": "string", "format": "uuid" },
          "downloadable": { "type": "boolean" },
          "formats": {
            "type": "array",
            "maxItems": 2,
            "items": { "$ref": "#/components/schemas/DownloadableFormat" }
          }
        }
      },
      "DownloadableFormat": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "format", "mediaType", "sizeBytes", "sha256", "licenseExpression", "attribution"],
        "properties": {
          "assetId": { "type": "string", "format": "uuid" },
          "format": { "type": "string", "enum": ["PDF", "EPUB"] },
          "mediaType": { "type": "string", "enum": ["application/pdf", "application/epub+zip"] },
          "sizeBytes": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 1073741824 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "licenseExpression": { "type": "string", "minLength": 2, "maxLength": 128 },
          "attribution": { "type": "string", "minLength": 2, "maxLength": 1000 }
        }
      },
      "DownloadAuthorization": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorizationId", "assetId", "downloadUrl", "expiresAt"],
        "properties": {
          "authorizationId": { "type": "string", "format": "uuid" },
          "assetId": { "type": "string", "format": "uuid" },
          "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "RegisterExternalResourceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceProvider", "sourceUrl", "downloadUrl", "mediaType", "licenseExpression", "licenseUrl", "attribution"],
        "properties": {
          "sourceProvider": { "type": "string", "minLength": 2, "maxLength": 100 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
          "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
          "mediaType": { "type": "string", "enum": ["application/pdf", "application/epub+zip"] },
          "licenseExpression": { "type": "string", "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "PDM-1.0"] },
          "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://creativecommons.org/", "maxLength": 2048 },
          "attribution": { "type": "string", "minLength": 2, "maxLength": 1000 }
        }
      },
      "ExternalResourceRegistration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "sourceProvider", "licenseExpression", "replayed"],
        "properties": {
          "resourceId": { "type": "string", "format": "uuid" },
          "sourceProvider": { "type": "string", "minLength": 2, "maxLength": 100 },
          "licenseExpression": { "type": "string", "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "PDM-1.0"] },
          "replayed": { "type": "boolean" }
        }
      },
      "ExternalResourceAvailability": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "downloadable", "sourceProvider", "mediaType", "licenseExpression"],
        "properties": {
          "resourceId": { "type": "string", "format": "uuid" },
          "downloadable": { "type": "boolean" },
          "sourceProvider": { "type": ["string", "null"], "minLength": 2, "maxLength": 100 },
          "mediaType": { "type": ["string", "null"], "enum": ["application/pdf", "application/epub+zip", null] },
          "licenseExpression": { "type": ["string", "null"], "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "PDM-1.0", null] }
        }
      },
      "ExternalDownloadAuthorization": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorizationId", "resourceId", "sourceProvider", "licenseExpression", "downloadUrl"],
        "properties": {
          "authorizationId": { "type": "string", "format": "uuid" },
          "resourceId": { "type": "string", "format": "uuid" },
          "sourceProvider": { "type": "string", "minLength": 2, "maxLength": 100 },
          "licenseExpression": { "type": "string", "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "PDM-1.0"] },
          "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 }
        }
      },
      "CreateIngestionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["editionId", "format", "sizeBytes", "sha256", "sourceProvider", "sourceUri", "licenseExpression", "attribution"],
        "properties": {
          "editionId": { "type": "string", "format": "uuid" },
          "format": { "type": "string", "enum": ["PDF", "EPUB"] },
          "sizeBytes": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 1073741824 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceProvider": { "type": "string", "minLength": 2, "maxLength": 100 },
          "sourceUri": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
          "licenseExpression": { "type": "string", "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "PDM-1.0"] },
          "attribution": { "type": "string", "minLength": 2, "maxLength": 1000 },
          "rightsExpiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "IngestionUploadGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ingestionId", "state", "uploadUrl", "method", "requiredHeaders", "uploadExpiresAt", "sessionExpiresAt", "replayed"],
        "properties": {
          "ingestionId": { "type": "string", "format": "uuid" },
          "state": { "type": "string", "const": "AWAITING_SCAN" },
          "uploadUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "method": { "type": "string", "const": "PUT" },
          "requiredHeaders": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "minProperties": 1,
            "maxProperties": 16
          },
          "uploadExpiresAt": { "type": "string", "format": "date-time" },
          "sessionExpiresAt": { "type": "string", "format": "date-time" },
          "replayed": { "type": "boolean" }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["status"],
        "properties": { "status": { "type": "integer" } }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Forbidden": {
        "description": "Required scope is missing",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "DownloadUnavailable": {
        "description": "The asset is absent or is not currently authorized, clean, global, and published",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "SigningUnavailable": {
        "description": "Download signing is unavailable",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "InvalidIngestion": {
        "description": "The ingestion manifest is invalid",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "IngestionConflict": {
        "description": "The ingestion identifier is already bound to another caller or manifest",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "IngestionExpired": {
        "description": "The ingestion session has expired",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "IngestionUnavailable": {
        "description": "Quarantine upload signing is unavailable",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "InvalidExternalResource": {
        "description": "The external rights manifest or URL shape is invalid",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "ExternalResourceConflict": {
        "description": "The resource identifier is already bound to another caller or manifest",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    }
  }
}
