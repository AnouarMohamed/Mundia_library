{
  "openapi": "3.1.0",
  "info": {
    "title": "Mundia Notification API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/notifications/me": {
      "get": {
        "operationId": "listOwnNotifications",
        "x-required-scopes": ["notification.inbox.read"],
        "parameters": [
          {"name": "status", "in": "query", "schema": {"$ref": "#/components/schemas/NotificationReadStatus"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 128}}
        ],
        "responses": {
          "200": {
            "description": "Caller-bound notification page",
            "headers": {"Cache-Control": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPage"}}}
          },
          "400": {"description": "Invalid bounded query"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Required scope or canonical membership claim missing"}
        }
      }
    },
    "/api/v1/notifications/preferences/me": {
      "get": {
        "operationId": "getOwnNotificationPreference",
        "x-required-scopes": ["notification.preferences.read"],
        "responses": {
          "200": {
            "description": "Caller-bound notification preference",
            "headers": {
              "Cache-Control": {"schema": {"type": "string"}},
              "ETag": {"schema": {"type": "string", "pattern": "^\\\"[0-9]+\\\"$"}}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPreference"}}}
          },
          "401": {"description": "Authentication required"},
          "403": {"description": "Required scope or canonical membership claim missing"}
        }
      },
      "put": {
        "operationId": "updateOwnNotificationPreference",
        "x-required-scopes": ["notification.preferences.write"],
        "parameters": [
          {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^\\\"[0-9]+\\\"$"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateNotificationPreferenceRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Preference updated or an identical request replayed",
            "headers": {
              "Cache-Control": {"schema": {"type": "string"}},
              "ETag": {"schema": {"type": "string", "pattern": "^\\\"[0-9]+\\\"$"}}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationPreference"}}}
          },
          "400": {"description": "Malformed strong preference version or request"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Required scope or canonical membership claim missing"},
          "409": {"description": "Preference version conflict"},
          "428": {"description": "If-Match preference version required"}
        }
      }
    },
    "/api/v1/notifications/{notificationId}/read": {
      "patch": {
        "operationId": "markOwnNotificationRead",
        "x-required-scopes": ["notification.inbox.write"],
        "parameters": [
          {"name": "notificationId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Idempotently marked read", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationItem"}}}},
          "401": {"description": "Authentication required"},
          "403": {"description": "Required scope or canonical membership claim missing"},
          "404": {"description": "Notification absent or not owned by caller"}
        }
      }
    },
    "/api/v1/notifications/email-suppressions/{memberId}/removal": {
      "post": {
        "operationId": "removeMemberEmailSuppression",
        "x-required-scopes": ["notification.suppression.write"],
        "parameters": [
          {"name": "memberId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RemoveEmailSuppressionRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Suppression removal was durably audited; removed is false when no suppression existed",
            "headers": {"Cache-Control": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmailSuppressionRemoval"}}}
          },
          "400": {"description": "Malformed idempotency key, member identifier, actor subject, or justification"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Suppression-management scope missing"},
          "409": {"description": "Idempotency key was already used for a different request"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationReadStatus": {"type": "string", "enum": ["ALL", "READ", "UNREAD"], "default": "ALL"},
      "NotificationCategory": {"type": "string", "enum": ["DUE_SOON", "OVERDUE", "HOLD_READY", "ACCOUNT_STATUS", "GENERAL"]},
      "NotificationItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notificationId", "category", "subject", "body", "occurredAt", "createdAt"],
        "properties": {
          "notificationId": {"type": "string", "format": "uuid"},
          "category": {"$ref": "#/components/schemas/NotificationCategory"},
          "subject": {"type": "string", "maxLength": 160},
          "body": {"type": "string", "maxLength": 2000},
          "occurredAt": {"type": "string", "format": "date-time"},
          "createdAt": {"type": "string", "format": "date-time"},
          "readAt": {"type": ["string", "null"], "format": "date-time"}
        }
      },
      "NotificationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "items"],
        "properties": {
          "memberId": {"type": "string", "format": "uuid"},
          "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/NotificationItem"}},
          "nextCursor": {"type": ["string", "null"], "maxLength": 128}
        }
      },
      "NotificationPreference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "emailEnabled", "dueSoonEnabled", "overdueEnabled", "holdReadyEnabled", "accountStatusEnabled", "version"],
        "properties": {
          "memberId": {"type": "string", "format": "uuid"},
          "emailEnabled": {"type": "boolean"},
          "dueSoonEnabled": {"type": "boolean"},
          "overdueEnabled": {"type": "boolean"},
          "holdReadyEnabled": {"type": "boolean"},
          "accountStatusEnabled": {"type": "boolean"},
          "version": {"type": "integer", "format": "int64", "minimum": 0},
          "updatedAt": {"type": ["string", "null"], "format": "date-time"}
        }
      },
      "UpdateNotificationPreferenceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["emailEnabled", "dueSoonEnabled", "overdueEnabled", "holdReadyEnabled", "accountStatusEnabled"],
        "properties": {
          "emailEnabled": {"type": "boolean"},
          "dueSoonEnabled": {"type": "boolean"},
          "overdueEnabled": {"type": "boolean"},
          "holdReadyEnabled": {"type": "boolean"},
          "accountStatusEnabled": {"type": "boolean"}
        }
      },
      "RemoveEmailSuppressionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["justification"],
        "properties": {
          "justification": {"type": "string", "minLength": 20, "maxLength": 500}
        }
      },
      "EmailSuppressionRemoval": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "memberId", "removed", "performedAt"],
        "properties": {
          "requestId": {"type": "string", "format": "uuid"},
          "memberId": {"type": "string", "format": "uuid"},
          "removed": {"type": "boolean"},
          "previousReason": {"type": ["string", "null"], "enum": ["PERMANENT_BOUNCE", "COMPLAINT", null]},
          "performedAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
