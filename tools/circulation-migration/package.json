{
  "name": "@mundiapolis/circulation-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "CIRCULATION_MIGRATION_REQUIRE_INTEGRATION=true tsx --test test/database.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
