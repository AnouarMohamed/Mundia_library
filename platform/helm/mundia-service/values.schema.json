{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "image",
    "replicaCount",
    "service",
    "resources",
    "autoscaling",
    "podDisruptionBudget",
    "networkPolicy",
    "externalSecret"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "staging", "prod"]
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 2 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "egressCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cidr", "ports"]
          }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": ["enabled", "secretStoreRef", "targetName", "data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "data": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "tls"]
    }
  }
}

