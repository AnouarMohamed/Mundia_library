{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "runtime",
    "image",
    "replicaCount",
    "service",
    "resources",
    "autoscaling",
    "podDisruptionBudget",
    "networkPolicy",
    "externalSecret",
    "env",
    "migration"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "staging", "prod"]
    },
    "runtime": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "env": {
      "type": "object",
      "required": ["SPRING_FLYWAY_ENABLED"],
      "properties": {
        "SPRING_FLYWAY_ENABLED": {
          "type": "string",
          "const": "false"
        }
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 2 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingressPeers",
        "egressCidrs",
        "allowOtelGateway",
        "otelGatewayNamespace"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowOtelGateway": { "type": "boolean" },
        "otelGatewayNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "ingressPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["namespace", "podLabels"]
          }
        },
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cidr", "ports"]
          }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": ["enabled", "secretStoreRef", "targetName", "data"],
      "properties": {
        "enabled": { "type": "boolean" },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["secretKey", "remoteKey", "property"],
            "properties": {
              "secretKey": {
                "type": "string",
                "not": {
                  "pattern": "^DATABASE_MIGRATION_"
                }
              },
              "remoteKey": {
                "type": "string",
                "minLength": 1
              },
              "property": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "enabled",
        "managedByPlatform",
        "activeDeadlineSeconds",
        "backoffLimit",
        "ttlSecondsAfterFinished",
        "tmpSizeLimit",
        "serviceAccount",
        "networkPolicy",
        "cleanup",
        "externalSecret",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "managedByPlatform": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400
        },
        "tmpSizeLimit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name", "automountToken"],
          "properties": {
            "create": {
              "type": "boolean",
              "const": true
            },
            "name": {
              "type": "string"
            },
            "automountToken": {
              "type": "boolean",
              "const": false
            }
          },
          "additionalProperties": false
        },
        "networkPolicy": {
          "type": "object",
          "required": ["enabled", "egressCidrs"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true
            },
            "egressCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["cidr", "ports"],
                "properties": {
                  "cidr": {
                    "type": "string",
                    "minLength": 3
                  },
                  "ports": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["protocol", "port"],
                      "properties": {
                        "protocol": {
                          "type": "string",
                          "const": "TCP"
                        },
                        "port": {
                          "type": "integer",
                          "const": 5432
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "cleanup": {
          "type": "object",
          "required": [
            "enabled",
            "rbacManagedByPlatform",
            "activeDeadlineSeconds",
            "backoffLimit",
            "ttlSecondsAfterFinished",
            "tokenExpirationSeconds",
            "apiServerCidrs",
            "resources"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true
            },
            "rbacManagedByPlatform": {
              "type": "boolean"
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 300
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 300,
              "maximum": 86400
            },
            "tokenExpirationSeconds": {
              "type": "integer",
              "minimum": 600,
              "maximum": 900
            },
            "apiServerCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 3,
                "not": {
                  "enum": ["0.0.0.0/0", "::/0"]
                }
              }
            },
            "resources": {
              "type": "object",
              "required": ["requests", "limits"]
            }
          },
          "additionalProperties": false
        },
        "externalSecret": {
          "type": "object",
          "required": [
            "enabled",
            "refreshInterval",
            "secretStoreRef",
            "targetName",
            "creationPolicy",
            "deletionPolicy",
            "data"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true
            },
            "refreshInterval": {
              "type": "string",
              "minLength": 2
            },
            "secretStoreRef": {
              "type": "object",
              "required": ["name", "kind"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": ["SecretStore", "ClusterSecretStore"]
                }
              }
            },
            "targetName": {
              "type": "string",
              "minLength": 3
            },
            "creationPolicy": {
              "type": "string",
              "enum": ["Owner"]
            },
            "deletionPolicy": {
              "type": "string",
              "enum": ["Retain"]
            },
            "data": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": ["secretKey", "remoteKey", "property"],
                "properties": {
                  "secretKey": {
                    "type": "string",
                    "enum": [
                      "DATABASE_MIGRATION_URL",
                      "DATABASE_MIGRATION_USERNAME",
                      "DATABASE_MIGRATION_PASSWORD"
                    ]
                  },
                  "remoteKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "property": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "tls"]
    }
  }
}
