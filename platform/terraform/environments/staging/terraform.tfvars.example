aws_account_id      = "REPLACE_STAGING_ACCOUNT_ID"
deployment_role_arn = "arn:aws:iam::REPLACE_STAGING_ACCOUNT_ID:role/REPLACE_TERRAFORM_ROLE"
region              = "REPLACE_PRIMARY_REGION"

configuration = {
  vpc_cidr                     = "10.50.0.0/16"
  availability_zone_count     = 3
  nat_gateway_per_az          = true
  kubernetes_version          = "REPLACE_APPROVED_EKS_MINOR"
  endpoint_public_access      = false
  public_access_cidrs         = []
  administrator_principal_arns = [
    "arn:aws:iam::REPLACE_STAGING_ACCOUNT_ID:role/REPLACE_SSO_ADMIN_ROLE"
  ]
  addon_versions = {
    coredns                = "REPLACE_EXACT_ADDON_VERSION"
    kube-proxy             = "REPLACE_EXACT_ADDON_VERSION"
    vpc-cni                = "REPLACE_EXACT_ADDON_VERSION"
    eks-pod-identity-agent = "REPLACE_EXACT_ADDON_VERSION"
  }
  node_instance_types = ["REPLACE_CAPACITY_TESTED_INSTANCE_TYPE"]
  node_min_size       = 3
  node_desired_size   = 3
  node_max_size       = 10

  dependency_contract = {
    postgres_secret_arn         = "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:mundia/staging/circulation/postgres"
    postgres_migration_secret_arn = "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:mundia/staging/circulation/postgres-migration"
    kafka_secret_arn            = "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:mundia/staging/circulation/kafka"
    redis_secret_arn            = "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:mundia/staging/circulation/redis"
    oidc_secret_arn             = "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:mundia/staging/circulation/oidc"
    otel_secret_arn             = "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:mundia/staging/platform/otel"
    object_storage_bucket_arn   = "arn:aws:s3:::REPLACE_STAGING_BUCKET"
    opensearch_endpoint         = "https://REPLACE_PRIVATE_OPENSEARCH_ENDPOINT"
    oidc_issuer_url             = "https://REPLACE_INSTITUTIONAL_OIDC_ISSUER"
    oidc_jwks_url               = "https://REPLACE_INSTITUTIONAL_OIDC_JWKS"
    otel_exporter_endpoint      = "https://REPLACE_OTLP_ENDPOINT"
    secret_manager_kms_key_arns = [
      "arn:aws:kms:REPLACE_REGION:REPLACE_ACCOUNT:key/REPLACE_KMS_KEY_ID"
    ]
  }
}

# Amazon MSK has no always-free tier. Keep this false until a reviewed plan,
# explicit cost approval, and a scheduled staging rehearsal are in place.
managed_kafka = {
  enabled                  = false
  kafka_version            = "REPLACE_APPROVED_MSK_KAFKA_VERSION"
  broker_instance_type     = "kafka.REPLACE_CAPACITY_TESTED_INSTANCE_TYPE"
  broker_count             = 3
  broker_volume_gib        = 100
  replication_factor       = 3
  minimum_in_sync_replicas = 2
  at_rest_kms_key_arn      = "arn:aws:kms:REPLACE_REGION:REPLACE_ACCOUNT:key/REPLACE_MSK_KMS_KEY_ID"
  log_kms_key_arn          = "arn:aws:kms:REPLACE_REGION:REPLACE_ACCOUNT:key/REPLACE_LOG_KMS_KEY_ID"
  scram_secret_arns = [
    "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:AmazonMSK_mundia-staging-membership-producer",
    "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:AmazonMSK_mundia-staging-circulation-consumer",
    "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT:secret:AmazonMSK_mundia-staging-operations-admin"
  ]
}
